//shader_type canvas_item;

// 振動の強さ
uniform highp float shake_power = 0.4;
// 振動率
uniform highp float shake_rate = 0.2;
// 振動速度
uniform highp float shake_speed = 5.0;
// 振動ブロックサイズ
uniform highp float shake_block_size = 30.5;
// 色の分離率
uniform highp float shake_color_rate = 0.01;

highp float random( highp float seed )
{
	return fract( 543.2543 * sin( dot( vec2( seed, seed ), vec2( 3525.46, -54.3415 ) ) ) );
}

void fragment()
{
	highp float enable_shift = float(zRandom(UV).x<shake_rate);

	highp vec2 fixed_uv = UV;
	fixed_uv.x += (random((trunc(UV.y * shake_block_size ) / shake_block_size )+TIME) - 0.5) * shake_power * enable_shift;

	highp vec4 pixel_color = textureLod( TEXTURE, fixed_uv, 0.0 );
	pixel_color.r = mix(pixel_color.r,textureLod( TEXTURE, fixed_uv + vec2( shake_color_rate, 0.0 ), 0.0 ).r,enable_shift);
	pixel_color.b = mix(pixel_color.b,textureLod( TEXTURE, fixed_uv + vec2( -shake_color_rate, 0.0 ), 0.0 ).b,enable_shift);
	COLOR = pixel_color;
}
