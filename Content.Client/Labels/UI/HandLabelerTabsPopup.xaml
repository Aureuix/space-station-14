<Popup
	xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.Labels.UI">
	<PanelContainer
		Margin="0, 0, 0, 0"
		MouseFilter="Stop">
		<PanelContainer.PanelOverride>
			<gfx:StyleBoxFlat BackgroundColor="#25252A" />
		</PanelContainer.PanelOverride>
		<BoxContainer
			Name="Container"
			Orientation="Vertical">
			<PanelContainer
				SetHeight="30"
				HorizontalExpand="true">
				<PanelContainer.PanelOverride>
					<gfx:StyleBoxFlat BackgroundColor="#2F2F3B" />
				</PanelContainer.PanelOverride>
				<RichTextLabel
					Name="Title"
					Text="{Loc 'hand-labeler-popup-title'}"
					Margin="5, 0, 0, 0"/>
				<Button
					Name="ClosePopup"
					Text="{Loc 'hand-labeler-popup-close'}"
					HorizontalAlignment="Right"
					StyleClasses="OpenRight"/>
			</PanelContainer>
			<ScrollContainer
				Margin="7"
				HorizontalExpand="true"
				VerticalExpand="true">
				<BoxContainer
					Name="Tabs"
					Orientation="Vertical">
				</BoxContainer>
			</ScrollContainer>
			<Button
				Name="NewTab"
				Margin="10"
				VerticalAlignment="Bottom"
				HorizontalAlignment="Center"
				SetHeight="30">
				<Label
					Align="Center"
					Text="{Loc 'hand-labeler-popup-new-tab'}"/>
			</Button>
		</BoxContainer>
	</PanelContainer>
</Popup>
