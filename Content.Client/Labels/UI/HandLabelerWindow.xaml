<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
            Title="{Loc 'hand-labeler-ui-header'}"
            MinWidth="430"
			MinHeight="323"
            SetWidth="430"
            SetHeight="491"> <!-- Kin Bin - Adjusted height/width to accommodate additional UI elements -->
	
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
		<!-- Kin Bin Begin -->
		<PanelContainer HorizontalExpand="True" StyleClasses="BackgroundPanelDark">
			<RichTextLabel Name="CurrentLabelPreview" HorizontalAlignment="Center" Margin="10"/>
		</PanelContainer>
		<!-- Kin Bin End -->
        <LineEdit Name="LabelLineEdit" />
		<!-- Kin Bin Begin -->
		<BoxContainer
			Orientation="Horizontal"
			HorizontalExpand="True">
			<RichTextLabel
				Name="CurrentLabelChars"
				HorizontalExpand="True"/>
			<Button
				Name="NewLabelButton"
				Text="{Loc 'hand-labeler-new-label-text'}"
				SetWidth="80"
				StyleClasses="ButtonSquare"
				TextAlign="Center"
				HorizontalAlignment="Right"/>
			<Button
				Name="ResetLabelButton"
				Text="{Loc 'hand-labeler-ui-reset-label-text'}"
				SetWidth="60"
				Margin="2 0 2 0"
				StyleClasses="ButtonSquare"
				TextAlign="Center"
				HorizontalAlignment="Right"/>
			<Button
				Name="ClearLabelButton"
				Text="{Loc 'hand-labeler-ui-clear-label-text'}"
				SetWidth="60"
				StyleClasses="OpenLeft"
				TextAlign="Center"
				HorizontalAlignment="Right"/>
		</BoxContainer>
		<BoxContainer
			Orientation="Horizontal"
			Margin ="0 -3 0 0"
			HorizontalExpand="True">
			<OptionButton
				Name="LabelTabsListButton"
				StyleClasses="OpenRight"
				HorizontalExpand="True">
				</OptionButton>
			<Button
				Name="LabelTabsEditButton"
				SetWidth="80"
				Margin="2 0 2 0"
				Text="Edit Tabs"
				StyleClasses="ButtonSquare"
				HorizontalAlignment="Right"/>
			<Button
				Name="SortLabelButton"
				SetWidth="122"
				Text="{Loc 'hand-labeler-sort-label-none'}"
				StyleClasses="ButtonSquare"
				HorizontalAlignment="Right"/>
		</BoxContainer>
		<PanelContainer
			HorizontalExpand="True"
			VerticalExpand="True"
			StyleClasses="TooltipPanel">
			<ScrollContainer
				VerticalExpand="true"
				HScrollEnabled="false"
				Margin="-6 0 -6 0">
				<BoxContainer
					Orientation="Vertical"
					Name="SavedLabelsContainer"
					HorizontalExpand="True"
					SeparationOverride="1"/>
			</ScrollContainer>
		</PanelContainer>
        <!-- Kin Bin End -->
	</BoxContainer>
</DefaultWindow>
